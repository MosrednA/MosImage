# Optimized baseline for Ryzen 7 9700X, 32 GB RAM, RTX 5070 Ti 16 GB.
# On a Mac, do not copy this file: the defaults switch to the Apple silicon
# profile (MPS, BF16 Klein 9B and 4B), and start.sh writes a minimal .env.
MOSIMAGE_HARDWARE_PROFILE=rtx5070ti-16gb
MOSIMAGE_PREFERRED_DEVICE=cuda
MOSIMAGE_PREFERRED_DTYPE=bfloat16
MOSIMAGE_ENABLE_TF32=true
MOSIMAGE_ENABLE_CPU_OFFLOAD=true
MOSIMAGE_RUNTIME_MODE=balanced
MOSIMAGE_ALLOW_CPU_GENERATION=false
MOSIMAGE_MAX_LOADED_PIPELINES=1
# Per-file upload read limit, Pillow's pixel warning threshold, and completed-job retention.
MOSIMAGE_MAX_UPLOAD_BYTES=67108864
MOSIMAGE_MAX_IMAGE_PIXELS=64000000
MOSIMAGE_JOB_RETENTION_SECONDS=600
MOSIMAGE_CUDA_ALLOC_CONF=expandable_segments:True
MOSIMAGE_CANCEL_GRACE_SECONDS=8
MOSIMAGE_INPAINT_MAX_DIMENSION=1024
MOSIMAGE_INPAINT_MINIMUM_DIMENSION=768
MOSIMAGE_INPAINT_CONTEXT_RATIO=0.5
MOSIMAGE_INPAINT_MINIMUM_CONTEXT=128
# Selection growth and softness are set on the canvas, not through environment variables.

# Load SAM and the Quality model in the background on start, about 25 s from the local cache.
MOSIMAGE_WARM_UP_ON_START=true
MOSIMAGE_WARM_UP_MODEL=flux2-klein-9b-nvfp4

# FLUX.2 Klein 9B (Quality) is gated: accept its licence on Hugging Face, then
# log in once with `hf auth login` or set a read token here. The other models
# are public. HF_TOKEN is also supported.
# MOSIMAGE_HF_TOKEN=hf_your_read_token

# Your own FLUX.2 Klein LoRAs (.safetensors), listed in Generation settings.
# Defaults to models/loras in the repository.
# MOSIMAGE_LORA_DIR=D:/LoRAs

# Leave as sdpa on Windows unless flash attention is installed and verified.
MOSIMAGE_ATTENTION_BACKEND=sdpa
