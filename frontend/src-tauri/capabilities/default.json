{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "On Windows the top bar is the title bar: it moves, minimizes, maximizes and closes the window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
